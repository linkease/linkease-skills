{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linkease/linkease-skills/schemas/recommendations.schema.json",
  "title": "LinkEase transport-neutral task recommendation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "recommendations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "prompt", "category", "priority", "executionIntent", "workspaceRequirement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "category": { "enum": ["common", "apps", "network", "storage", "maintenance", "advanced"] },
          "priority": { "type": "integer", "minimum": 0 },
          "risk": { "enum": ["low", "medium", "high"] },
          "executionIntent": { "enum": ["read_only", "may_modify", "heavy_write"] },
          "workspaceRequirement": { "enum": ["none", "durable"] },
          "estimatedWriteBytes": { "type": "integer", "minimum": 0 },
          "locatorFeatures": { "$ref": "#/$defs/stringSet" },
          "systems": { "$ref": "#/$defs/stringSet" },
          "features": { "$ref": "#/$defs/stringSet" },
          "requires": { "$ref": "#/$defs/stringSet" },
          "skill": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

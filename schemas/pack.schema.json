{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linkease/linkease-skills/schemas/pack.schema.json",
  "title": "LinkEase canonical system pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "layer", "skillsRoot"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "layer": { "enum": ["common", "family", "distribution", "variant"] },
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "osFamily": { "type": "string" },
        "distribution": { "type": "string" },
        "variant": { "type": "string" }
      }
    },
    "skillsRoot": { "type": "string", "minLength": 1 },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
